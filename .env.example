# Backend (Spring Boot)

# Database
DB_URL=jdbc:mysql://localhost:3306/devvault?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Server
SERVER_PORT=8080

# Security - change in production!
JWT_SECRET=devvault-super-secret-jwt-signing-key-change-me-in-production-2024
JWT_EXPIRATION_MS=86400000

# Storage
STORAGE_LOCATION=./storage

# CORS - comma separated origins
CORS_ALLOWED_ORIGINS=  http://localhost:3000